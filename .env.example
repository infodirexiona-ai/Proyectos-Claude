# --- Modo de operación ------------------------------------------------------
# real: se conecta al portal del SII con un navegador.
# demo: datos de ejemplo, para probar la app sin credenciales.
SII_MODO=demo

# --- Credenciales -----------------------------------------------------------
# Clave con la que se cifra la clave tributaria en la base de datos.
# Genera una con:  python -m app.cli generar-clave
SII_CLAVE_CIFRADO=

# Opcional: credenciales por defecto (también se pueden cargar desde la web).
SII_RUT=
SII_CLAVE_TRIBUTARIA=

# --- Almacenamiento ---------------------------------------------------------
# SII_DB_URL=sqlite:///./data/sii.db
# SII_DIR_DESCARGAS=./data/descargas

# --- Navegador / red --------------------------------------------------------
# Pon SII_HEADLESS=false para ver el navegador mientras se autentica.
SII_HEADLESS=true
SII_TIMEOUT_MS=45000
# Ruta a un Chromium ya instalado (si no, se usa el de 'playwright install').
# SII_RUTA_NAVEGADOR=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
# Pausa entre llamadas al SII, en segundos.
SII_PAUSA_ENTRE_LLAMADAS=0.8
